# Operating-system and editor noise
.DS_Store
Thumbs.db

# Go build outputs (build.sh writes dist/<name>-<os>-<arch>/ …)
dist/

# Runtime state — apps write stores to their own data/ dirs (SQLite,
# alert baselines) and APPDECK_DATA at runtime; never ship them
data/
*.db
*.db-shm
*.db-wal
*.log
logs/

# Caches
__pycache__/
*.pyc
.cache/
node_modules/

# Secrets
.env
.env.*

# Tests stay local (same convention as the other repos)
*_test.go

# App binaries built into their folders by build.sh / folder mode
# (apps.json points at ../Apps/<App>/<binary>; rebuildable, never ship)
Descale/descale
AppScopeMonitor/monitor
Sentinel/sentinel
RepoLens/repolens

# Platform-specific Go binaries from local builds
AppScopeMonitor/monitor-*
Sentinel/sentinel-*
Descale/descale-*
RepoLens/repolens-*
